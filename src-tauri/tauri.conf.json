{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatLingo",
  "version": "1.0.0",
  "identifier": "com.remsy.chatlingo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RTY5NkM4NDAzQTUyOTMKUldTVFVqcEF5SmJtOS8ydlhCaVpUZEFNWG1XcXIxQUxNSGMrNXMwaDlmTGQ5ZGFKYkxieG5JVTUK",
      "endpoints": [
        "https://github.com/rem-sy/chatlingo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
